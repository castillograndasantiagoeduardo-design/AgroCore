# Servidor HTTP (Backend/apps/api)
PORT=8001
# Único origen que acepta CORS (la API es abierta, sin login)
FRONTEND_ORIGIN=http://localhost:3000

# Base de Datos MySQL 8 (@agrocore/database)
DB_HOST=localhost
DB_PORT=3306
DB_USER=agrocore_app
DB_PASSWORD=tu_password_aqui
DB_NAME=agrocore

# NASA Earthdata (opcional, para AppEEARS)
EARTHDATA_TOKEN=

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8001

# Impresora térmica ESC/POS (Xprinter 58 mm compartida en Windows)
IMPRESORA_COMPARTIDA=XP58
# n de ESC t n: 2 = PC850 (confirmar con la hoja de autoprueba: apagar, mantener FEED, encender)
IMPRESORA_CODEPAGE=2
IMPRESORA_CORTADOR=false

# Región del precálculo (opcional). Dentro de "detalle" un clic se resuelve solo con MySQL, sin proveedores externos.
# Formato: clima=<sur>,<oeste>,<norte>,<este>;detalle=<sur>,<oeste>,<norte>,<este>   (grados)
#   clima   = celdas de NASA POWER con serie diaria de 30 años (por defecto Colombia continental)
#   detalle = vías/edificaciones/agua, cobertura MODIS y elevación (por defecto Boyacá)
# Si no está, se usan estos valores por defecto. Se llena con: deno run -A --env-file=../.env scripts/precalcular-region.ts
# REGION_PRECALCULO=clima=-4.3,-79.1,12.6,-66.8;detalle=4.6,-74.7,7.15,-71.9
