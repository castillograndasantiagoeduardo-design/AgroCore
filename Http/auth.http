@baseUrl = http://localhost:8001/api
# Define aquí tus credenciales de prueba en desarrollo
@email = admin@duitamacrece.co
@password = TU_CONTRASENA_AQUI

### Iniciar sesión exitoso (200 OK)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Error por formato inválido (400 Bad Request)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "correo-no-valido",
  "password": ""
}

### Error por credenciales inválidas (401 Unauthorized)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "no_existe@duitamacrece.co",
  "password": "password_incorrecto"
}

